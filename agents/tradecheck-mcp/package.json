{
  "name": "tradecheck-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked purchase order and supplier invoice review for importer workflows",
  "scripts": {
    "build": "tsc && esbuild src/browser.ts --bundle --format=esm --target=es2022 --outfile=dist/browser.js",
    "start": "node dist/server.js",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "@modelcontextprotocol/server": "2.0.0", "zod": "4.6.5" },
  "devDependencies": { "@modelcontextprotocol/client": "2.0.0", "@types/node": "24.10.1", "esbuild": "0.25.12", "typescript": "5.9.3" }
}
