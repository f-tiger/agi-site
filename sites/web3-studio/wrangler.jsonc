{
  "name": "agi-web3-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "web3.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "reconcile.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "evidence.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "route.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "protocol.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "permit.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "compute.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "incentives.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "proof.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "calls.agiscorecard.com",
      "custom_domain": true
    },
    {
      "pattern": "disclosures.agiscorecard.com",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "EVENT_LIMIT",
      "namespace_id": "260919933",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MCP_LIMIT",
      "namespace_id": "260919934",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
