{
  // Reviewed public assets bypass compute; HTML, APIs, auth and private paths stay Worker-first.
  // Code Word · codeword.agiscorecard.com — built 2026-09-15 (owner: 扩展几个适配欧洲、美国的站点).
  // Fleet standard shape: static assets + worker (allow-listed events, server-side page_view, /api/pulse).
  // D1: account is at the 10-database limit (create returns 7406), so this reuses after35-events
  // with table prefix "c" (cev / cua_audit). Sites never share a table.
  "name": "codeword",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "site", "binding": "ASSETS", "run_worker_first": [
      "/*",
      "!/analytics-assets/consent.mjs",
      "!/analytics-assets/collector.mjs",
      "!/analytics-assets/consent.css",
      "!/analytics-assets/frame-loader.mjs",
      "!/analytics-assets/business.mjs",
      "!/analytics-assets/legacy.mjs",
      "!/analytics-assets/campaign.mjs",
      "!/analytics-assets/engagement.mjs",
      "!/analytics-assets/registry.mjs",
      "!/app.js",
      "!/style.css"
] },
  "routes": [{ "pattern": "codeword.agiscorecard.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "EV", "database_name": "after35-events", "database_id": "6109b81e-c970-47d7-b7fc-3a2a15f68ed2" }],
  // 部署版本 id 做 Cache API 键的一部分(2026-09-26 D1 读预算):每次部署自然失效,不必手动清缓存。
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
