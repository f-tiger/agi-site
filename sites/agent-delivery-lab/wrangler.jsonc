{
  "name": "agi-agent-delivery-lab",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "assets": {"directory":"./dist","binding":"ASSETS","run_worker_first": [
      "/*",
      "!/analytics-assets/consent.mjs",
      "!/analytics-assets/collector.mjs",
      "!/analytics-assets/consent.css",
      "!/analytics-assets/frame-loader.mjs",
      "!/analytics-assets/business.mjs",
      "!/analytics-assets/legacy.mjs",
      "!/analytics-assets/campaign.mjs",
      "!/analytics-assets/engagement.mjs",
      "!/analytics-assets/registry.mjs",
      "!/mark.svg",
      "!/share.png",
      "!/app.mjs",
      "!/style.css",
      "!/engine.mjs",
      "!/runner.mjs"
],"html_handling":"none","not_found_handling":"none"},
  "routes": [{"pattern":"verify.agiscorecard.com","custom_domain":true}],
  "ratelimits": [{"name":"EVENT_LIMIT","namespace_id":"260919742","simple":{"limit":20,"period":60}}]
}
