{
	"vars": {"MEMBERS_ENABLED":"true"},
  "name": "ecoback",
	"main": "src/worker.js",
	"compatibility_date": "2026-07-01",
	"routes": [
		{ "pattern": "getecoback.com/*", "zone_name": "getecoback.com" },
		{ "pattern": "www.getecoback.com/*", "zone_name": "getecoback.com" }
	],
	// 2026-09-26:cachedJson 用部署版本做 Cache API 键的一部分(D1 读预算事故)。
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"d1_databases": [
		{
			"binding": "EVENTS",
			"database_name": "ecoback-events",
			"database_id": "75e45e05-44b5-4c56-9a3b-dd504b5c53f1"
		}
	],
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"html_handling": "none",
		"not_found_handling": "404-page",
		"run_worker_first": true
	}
}
