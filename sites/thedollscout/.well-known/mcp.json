      "mimeType": "application/json"
    },
    {
      "uri": "https://thedollscout.com/collector-assets/tool-capabilities.json",
      "name": "Collector tool catalog",
      "mimeType": "application/json"
    },
    {
      "uri": "https://thedollscout.com/collector-assets/brand-guides.json",
      "name": "Published collecting guides",
      "mimeType": "application/json"
    },
    {
      "uri": "https://thedollscout.com/document-assets/tool-capabilities.json",
      "name": "Existing browser-only digital tools",
      "mimeType": "application/json"
    }
  ],
  "documentation": "https://thedollscout.com/for-agents",
  "catalog": "https://thedollscout.com/collector-assets/tool-capabilities.json",
  "registryManifest": "https://thedollscout.com/mcp/server.json"
