  "endpoint": "https://thedollscout.com/mcp",
  "transport": "streamable-http",
  "protocolVersion": "2025-06-18",
  "tools": [
    "labubu_rarity_odds",
    "labubu_fake_signals",
    "secret_pull_probability",
    "define_labubu_term",
    "calculate_style_probability",
    "find_collector_tools",
    "get_collecting_guide",
    "plan_display_fit",
    "compare_blind_box_budget",
    "estimate_collection_progress",
    "search_collection_series",
    "prepare_collection_checklist"
