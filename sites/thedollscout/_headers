# CC-BY datasets and AI-index files are meant to be fetched cross-origin — by
# the MCP endpoint's consumers, by browser-side agents, by anyone re-using the
# data under the licence. The MCP endpoint has always sent
# Access-Control-Allow-Origin: *, but the files it points at did not, so a
# browser-based agent could call the tool and still fail to fetch the source.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/.well-known/mcp.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
