# CC-BY datasets and AI-index files are meant to be fetched cross-origin — by
# the MCP endpoint's consumers, by browser-side agents, by anyone re-using the
# data under the licence. The MCP endpoint has always sent
# Access-Control-Allow-Origin: *, but the files it points at did not, so a
# browser-based agent could call the tool and still fail to fetch the source.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/.well-known/mcp.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

# Static assets: Pages defaults unmatched files to max-age=0, so every
# navigation revalidated 5-6 subresources. No fingerprinting on this site, so
# keep the TTL short and let stale-while-revalidate hide the round trip.
/css/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/img/*
  Cache-Control: public, max-age=604800

/document-assets/*
  Cache-Control: public, max-age=600
  X-Content-Type-Options: nosniff

/document-assets/text/*
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/document-assets/tool-capabilities.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
