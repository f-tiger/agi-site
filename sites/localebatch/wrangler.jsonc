{
  "name": "agi-localebatch-pilot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-18",
  "assets": {"directory":"./site","binding":"ASSETS","run_worker_first": [
      "/*",
      "!/analytics-assets/consent.mjs",
      "!/analytics-assets/collector.mjs",
      "!/analytics-assets/consent.css",
      "!/analytics-assets/frame-loader.mjs",
      "!/analytics-assets/business.mjs",
      "!/analytics-assets/legacy.mjs",
      "!/analytics-assets/campaign.mjs",
      "!/analytics-assets/engagement.mjs",
      "!/analytics-assets/registry.mjs",
      "!/acquisition.mjs",
      "!/app.mjs",
      "!/core.mjs",
      "!/discovery.css",
      "!/discovery.mjs",
      "!/onboarding.mjs",
      "!/social.png",
      "!/styles.css"
],"html_handling":"drop-trailing-slash","not_found_handling":"none"},
  "routes": [{"pattern":"localebatch.agiscorecard.com","custom_domain":true}],
  "workers_dev": true,
  "vars": {"SALES_ENABLED":"false","QUALITY_REVIEWED":"false","SITE_ORIGIN":"https://localebatch.agiscorecard.com"}
  // The public checker requires no D1, queue, payment secrets or cron.
  // Add paid infrastructure only after its separate live integration checks.
}
