{
  // 识骗 · fanzha.agiscorecard.com — 2026-09-15 建站(owner /goal「持续做新站点…调研再做」;方向候选 #1,
  // 调研 docs/research-2026-09-15.md)。
  // 舰队标准形态:静态资产 + worker(白名单事件 + 服务端 page_view + /api/pulse)。
  // D1:账号已到 10 库上限(建库返回 7406),故复用 after35-events 库,表名前缀 f(fev / fua_audit)。
  "name": "fanzha",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "site", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "fanzha.agiscorecard.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "EV", "database_name": "after35-events", "database_id": "6109b81e-c970-47d7-b7fc-3a2a15f68ed2" }],
  // 部署版本 id 做 Cache API 键的一部分(2026-09-26 D1 读预算):每次部署自然失效,不必手动清缓存。
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
