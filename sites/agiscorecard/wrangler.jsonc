{
  // Deploy config for agiscorecard.com — static site + first-party event collector.
  //
  // HTML and dynamic routes stay Worker-first for analytics/account injection.
  // Only reviewed public assets bypass it; see tools/fleet/worker-budget-routing.json.
  // Keep not_found_handling so missing pages retain the existing custom 404.
  //
  // See also .assetsignore: Workers do NOT auto-exclude .git the way Pages did, so it
  // is excluded explicitly. Without it the whole repo history ships as public assets.
  "vars": {"MEMBERS_ENABLED":"true"},
  "ai": {"binding":"AI"},
  // Jarvis reuses the existing two-hourly maintenance workflow: the account's
  // five free Worker cron slots are already occupied. No new paid plan or cron.
  "name": "agiscorecard",
  "main": "tools/analytics-worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/analytics-assets/consent.mjs",
      "!/analytics-assets/collector.mjs",
      "!/analytics-assets/consent.css",
      "!/analytics-assets/frame-loader.mjs",
      "!/analytics-assets/business.mjs",
      "!/analytics-assets/legacy.mjs",
      "!/analytics-assets/campaign.mjs",
      "!/analytics-assets/engagement.mjs",
      "!/analytics-assets/registry.mjs",
      "!/og-image.png",
      "!/market-odds.js",
      "!/scorecard-summary.png",
      "!/scorecard-summary-dark.png",
      "!/community-assets/*",
      "!/roadmap-assets/*",
      "!/portfolio-assets/*",
      "!/futures-assets/*",
      "!/site-nav/*",
      "!/share/*",
      "!/foresight-assets/*",
      "!/earn-assets/*",
      "!/infrastructure-assets/*",
      "!/capital-radar-assets/*",
      "!/jarvis-assets/*",
      "!/badge/*",
      "!/invest-research/*",
      "!/evidence-assets/*",
      "!/tianya-assets/*",
      "!/create-assets/*",
      "!/mentor-assets/*",
      "!/home-focus/*",
      "!/tianya-research/agi-research.css",
      "!/tianya-research/app.mjs",
      "!/tianya-research/archive-data.mjs",
      "!/tianya-research/archive-ui.mjs",
      "!/tianya-research/conclusions-data.mjs",
      "!/tianya-research/conclusions-ui.mjs",
      "!/tianya-research/cross-evidence.mjs",
      "!/tianya-research/data.mjs",
      "!/tianya-research/deep-records.mjs",
      "!/tianya-research/dual-path-data.mjs",
      "!/tianya-research/dual-path-ui.mjs",
      "!/tianya-research/engine.mjs",
      "!/tianya-research/expansion.mjs",
      "!/tianya-research/frontiers-data.mjs",
      "!/tianya-research/future-data.mjs",
      "!/tianya-research/future-ui.mjs",
      "!/tianya-research/history-data.mjs",
      "!/tianya-research/neural-data.mjs",
      "!/tianya-research/neural-ui.mjs",
      "!/tianya-research/opportunity-data.mjs",
      "!/tianya-research/opportunity-ui.mjs",
      "!/tianya-research/practice-data.mjs",
      "!/tianya-research/practice-ledger.mjs",
      "!/tianya-research/practice-ui.mjs",
      "!/tianya-research/processing-summary.mjs",
      "!/tianya-research/processing-ui.mjs",
      "!/tianya-research/round3-data.mjs",
      "!/tianya-research/round4-data.mjs",
      "!/tianya-research/round5-evidence.mjs",
      "!/tianya-research/styles.css",
      "!/tianya-research/temporal-data.mjs",
      "!/tianya-research/temporal-ui.mjs"
],
    "not_found_handling": "404-page"
  },
  // 2026-09-26 D1 读预算:/api/pulse、/api/trends 与 owner-alerts 聚合块经 Cache API 缓存,
  // 缓存键带部署版本 id,新部署自动换键——部署后自检读到的一定是新版算出的数。
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "EVENTS",
      "database_name": "agiscorecard-events",
      "database_id": "f84f9d29-3ad9-4b37-b28e-3a78027d2f22"
    }
  ]
}
