{
  // fleet-x-poster:每日从队列发一条到 owner 本人 X 账号。
  // 无 CF cron——账号免费版 5 个 cron 已满(2026-08-21 实测 code 10072),改由
  // GitHub Actions schedule(x-poster-cron.yml,公开仓免费)POST /run 触发,
  // 请求头 x-run-key 必须匹配 worker secret X_RUN_KEY。
  // 密钥不在此文件——由 deploy-x-poster.yml 从 GitHub Secrets 注入 wrangler secret。
  "name": "fleet-x-poster",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [
    { "binding": "STATE", "id": "a1c40e98ec7a44298d74d94d4a6084d1" }
  ]
}
